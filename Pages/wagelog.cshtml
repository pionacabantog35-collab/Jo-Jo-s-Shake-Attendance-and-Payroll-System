@page
@model Shakepayrollsystem.Pages.wagelogModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wagelog - Shake Payroll System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/wagelog.css" />
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="logo-container">
                <img src="~/images/logologin.png" alt="Logo" class="sidebar-logo">
            </div>
            
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="/dashboard">
                            <i class="fas fa-tachometer-alt"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/staff">
                            <i class="fas fa-users"></i>
                            <span>Staff</span>
                        </a>
                    </li>
                    <li>
                        <a href="/attendance">
                            <i class="fas fa-calendar-check"></i>
                            <span>Attendance</span>
                        </a>
                    </li>
                    <li>
                        <a href="/payroll">
                            <i class="fas fa-money-bill-wave"></i>
                            <span>Payroll</span>
                        </a>
                    </li>
                    <li class="active">
                        <a href="/wagelog">
                            <i class="fas fa-clock"></i>
                            <span>Wagelog</span>
                        </a>
                    </li>
                </ul>
            </nav>
            
            <div class="sidebar-footer">
                <form method="post" asp-page-handler="Logout" style="display: inline;">
                    <button type="submit" style="background: none; border: none; color: rgba(255,255,255,0.8); cursor: pointer; width: 100%; text-align: left; padding: 12px;">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Header -->
            <header class="top-header">
                <div class="menu-toggle">
                    <i class="fas fa-bars"></i>
                </div>
                <h1>Wagelog</h1>
                <div class="user-info">
                    <span>Welcome, @Model.Username</span>
                    <div class="user-avatar">
                        <i class="fas fa-user-circle"></i>
                    </div>
                </div>
            </header>

            <!-- Wagelog Content -->
            <div class="content">
                <!-- Alert Messages -->
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-error">@Model.ErrorMessage</div>
                }

                <!-- Filter Bar -->
                <div class="filter-bar">
                    <h3><i class="fas fa-filter"></i> Filter Wage Logs</h3>
                    <div class="filter-group">
                        <div class="filter-item">
                            <label>Month:</label>
                            <input type="month" id="monthPicker" class="filter-input" value="@Model.SelectedMonth">
                        </div>

                        <div class="filter-item">
                            <label>Staff:</label>
                            <select id="filterStaff" class="filter-input">
                                <option value="">All Staff</option>
                                @if (Model.StaffList != null && Model.StaffList.Rows.Count > 0)
                                {
                                    @foreach (System.Data.DataRow staff in Model.StaffList.Rows)
                                    {
                                        <option value="@staff["username"]" selected="@(Model.FilterStaff == staff["username"].ToString())">
                                            @staff["username"]
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="filter-actions">
                            <button class="btn btn-primary" onclick="applyFilters()">
                                <i class="fas fa-search"></i> Filter
                            </button>
                            <button class="btn btn-secondary" onclick="resetFilters()">
                                <i class="fas fa-sync-alt"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Summary Cards -->
                <div class="summary-cards">
                    <div class="summary-card">
                        <div class="summary-icon" style="background: #e3f2fd;">
                            <i class="fas fa-users" style="color: #1976d2;"></i>
                        </div>
                        <div class="summary-details">
                            <h3>Total Records</h3>
                            <p class="summary-number">@Model.TotalRecords</p>
                        </div>
                    </div>

                    <div class="summary-card">
                        <div class="summary-icon" style="background: #e8f5e9;">
                            <i class="fas fa-money-bill-wave" style="color: #4caf50;"></i>
                        </div>
                        <div class="summary-details">
                            <h3>Total Gross Pay</h3>
                            <p class="summary-number">₱ @Model.TotalGrossPay.ToString("N2")</p>
                        </div>
                    </div>

                    <div class="summary-card">
                        <div class="summary-icon" style="background: #fff3e0;">
                            <i class="fas fa-calculator" style="color: #ff9800;"></i>
                        </div>
                        <div class="summary-details">
                            <h3>Total Deductions</h3>
                            <p class="summary-number">₱ @Model.TotalDeductions.ToString("N2")</p>
                        </div>
                    </div>

                    <div class="summary-card">
                        <div class="summary-icon" style="background: #fce4ec;">
                            <i class="fas fa-wallet" style="color: #c2185b;"></i>
                        </div>
                        <div class="summary-details">
                            <h3>Total Net Pay</h3>
                            <p class="summary-number">₱ @Model.TotalNetPay.ToString("N2")</p>
                        </div>
                    </div>
                </div>

                <!-- Wage Log Table -->
                <div class="card">
                    <div class="card-header">
                        <h3><i class="fas fa-clock"></i> Wage Log Records</h3>
                        <span>Page @Model.CurrentPage of @Model.TotalPages</span>
                    </div>
                    <div class="card-body table-container">
                        <table class="wagelog-table">
                            <thead>
                                <tr>
                                    <th>Username</th>
                                    <th>Cut Off Start</th>
                                    <th>Cut Off End</th>
                                    <th>Hours Worked</th>
                                    <th>Gross Pay</th>
                                    <th>Total Deduction</th>
                                    <th>Net Pay</th>
                                    <th>Date Paid</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.WageLogs != null && Model.WageLogs.Rows.Count > 0)
                                {
                                    @foreach (System.Data.DataRow row in Model.PagedWageLogs)
                                    {
                                        <tr>
                                            <td><strong>@row["username"]</strong></td>
                                            <td>@Convert.ToDateTime(row["cutOffStart"]).ToString("MMM dd, yyyy")</td>
                                            <td>@Convert.ToDateTime(row["cutOffEnd"]).ToString("MMM dd, yyyy")</td>
                                            <td>@row["hoursWorked"] hrs</td>
                                            <td>₱ @Convert.ToDecimal(row["grossPay"]).ToString("N2")</td>
                                            <td>₱ @Convert.ToDecimal(row["totalDeduction"]).ToString("N2")</td>
                                            <td class="net-pay">₱ @Convert.ToDecimal(row["netPay"]).ToString("N2")</td>
                                            <td>@Convert.ToDateTime(row["datePaid"]).ToString("MMM dd, yyyy")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="empty-state">
                                            <i class="fas fa-clock"></i>
                                            <p>No wage log records found.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="pagination">
                                <button class="page-btn" onclick="changePage(1)" @(Model.CurrentPage == 1 ? "disabled" : "")>
                                    <i class="fas fa-angle-double-left"></i>
                                </button>
                                <button class="page-btn" onclick="changePage(@(Model.CurrentPage - 1))" @(Model.CurrentPage == 1 ? "disabled" : "")>
                                    <i class="fas fa-angle-left"></i>
                                </button>
                                
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    if (i >= Model.CurrentPage - 2 && i <= Model.CurrentPage + 2)
                                    {
                                        <button class="page-btn @(i == Model.CurrentPage ? "active" : "")" onclick="changePage(@i)">
                                            @i
                                        </button>
                                    }
                                }
                                
                                <button class="page-btn" onclick="changePage(@(Model.CurrentPage + 1))" @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")>
                                    <i class="fas fa-angle-right"></i>
                                </button>
                                <button class="page-btn" onclick="changePage(@Model.TotalPages)" @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")>
                                    <i class="fas fa-angle-double-right"></i>
                                </button>
                            </div>
                        }

                        <!-- Records Info -->
                        <div class="records-info">
                            Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to 
                            @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords) 
                            of @Model.TotalRecords records
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Filter functions
        function applyFilters() {
            var month = document.getElementById('monthPicker').value;
            var staff = document.getElementById('filterStaff').value;
            
            var url = '/wagelog?';
            if (month) url += 'selectedMonth=' + encodeURIComponent(month) + '&';
            if (staff) url += 'filterStaff=' + encodeURIComponent(staff) + '&';
            url += 'page=1';
            
            window.location.href = url;
        }

        function resetFilters() {
            window.location.href = '/wagelog';
        }

        // Pagination
        function changePage(page) {
            var url = new URL(window.location.href);
            url.searchParams.set('page', page);
            window.location.href = url.toString();
        }

        // Menu toggle
        document.querySelector('.menu-toggle').addEventListener('click', function() {
            document.querySelector('.sidebar').classList.toggle('active');
        });

        // Auto-submit when staff filter changes (optional)
        document.getElementById('filterStaff').addEventListener('change', function() {
            applyFilters();
        });
    </script>
</body>
</html>