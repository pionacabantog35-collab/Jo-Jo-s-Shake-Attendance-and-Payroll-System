@page
@model Shakepayrollsystem.Pages.attendanceModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance Management - Shake Payroll System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/attendance.css" />
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="logo-container">
                <img src="~/images/logologin.png" alt="Logo" class="sidebar-logo">
            </div>
            
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="/dashboard">
                            <i class="fas fa-tachometer-alt"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/staff">
                            <i class="fas fa-users"></i>
                            <span>Staff</span>
                        </a>
                    </li>
                    <li class="active">
                        <a href="/attendance">
                            <i class="fas fa-calendar-check"></i>
                            <span>Attendance</span>
                        </a>
                    </li>
                    <li>
                        <a href="/payroll">
                            <i class="fas fa-money-bill-wave"></i>
                            <span>Payroll</span>
                        </a>
                    </li>
                    <li>
                        <a href="/wagelog">
                            <i class="fas fa-clock"></i>
                            <span>Wagelog</span>
                        </a>
                    </li>
                </ul>
            </nav>
            
            <div class="sidebar-footer">
                <form method="post" asp-page-handler="Logout" style="display: inline;">
                    <button type="submit" style="background: none; border: none; color: rgba(255,255,255,0.8); cursor: pointer; width: 100%; text-align: left; padding: 12px;">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Header -->
                    <header class="top-header">
                <div class="menu-toggle">
                    <i class="fas fa-bars"></i>
                </div>
                <h1>Attendance Management</h1>
                <div class="user-info">
                    <span>Welcome, @Model.Username</span>
                    <div class="user-avatar">
                        <i class="fas fa-user-circle"></i>
                    </div>
                </div>
            </header>

            <!-- Attendance Content -->
            <div class="content">
                <!-- Alert Messages -->
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-error">@Model.ErrorMessage</div>
                }

                <!-- Filter Bar -->
                <div class="filter-bar">
                    <div class="filter-group">
                        <div class="filter-item">
                            <label>Month:</label>
                            <input type="month" id="monthPicker" class="filter-input" value="@Model.SelectedMonth">
                        </div>

                        <div class="filter-item">
                            <label>Staff:</label>
                            <select id="staffSelect" class="filter-input">
                                <option value="">All Staff</option>
                                @foreach (var staff in Model.StaffUsernames)
                                {
                                    <option value="@staff" selected="@(Model.SelectedStaff == staff)">@staff</option>
                                }
                            </select>
                        </div>

                        <div class="filter-actions">
                            <button class="btn btn-primary" onclick="applyFilters()">
                                <i class="fas fa-search"></i> Filter
                            </button>
                            <button class="btn btn-secondary" onclick="refreshPage()">
                                <i class="fas fa-sync-alt"></i> Refresh
                            </button>
                        </div>
                    </div>
                </div>
                </div>
                <!-- Attendance Table -->
                <div class="card">
                    <div class="card-header">
                        <h3>Attendance Records</h3>
                        <span>Total Records: @(Model.AttendanceList?.Rows.Count ?? 0)</span>
                    </div>
                    <div class="card-body table-container">
                        <table class="attendance-table" id="attendanceTable">
                            <thead>
                                <tr>
                                    <th>Username</th>
                                    <th>Date</th>
                                    <th>Time In</th>
                                    <th>Time Out</th>
                                    <th>Status</th>
                                    <th>Hours Worked</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.AttendanceList != null && Model.AttendanceList.Rows.Count > 0)
                                {
                                    @foreach (System.Data.DataRow row in Model.PagedAttendance)
                                    {
                                        string statusClass = row["status"].ToString() == "On-Time" ? "status-ontime" : "status-late";
                                        <tr>
                                            <td>@row["username"]</td>
                                            <td>@Convert.ToDateTime(row["date"]).ToString("MMM dd, yyyy")</td>
                                            <td>@row["timeIN"]</td>
                                            <td>@row["timeOUT"]</td>
                                            <td><span class="status-badge @statusClass">@row["status"]</span></td>
                                            <td>@row["hoursWorked"] hrs</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="empty-state">
                                            <i class="fas fa-calendar-times"></i>
                                            <p>No attendance records found.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="pagination">
                                <button class="page-btn" onclick="changePage(1)" @(Model.CurrentPage == 1 ? "disabled" : "")>
                                    <i class="fas fa-angle-double-left"></i>
                                </button>
                                <button class="page-btn" onclick="changePage(@(Model.CurrentPage - 1))" @(Model.CurrentPage == 1 ? "disabled" : "")>
                                    <i class="fas fa-angle-left"></i>
                                </button>
                                
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    if (i >= Model.CurrentPage - 2 && i <= Model.CurrentPage + 2)
                                    {
                                        <button class="page-btn @(i == Model.CurrentPage ? "active" : "")" onclick="changePage(@i)">
                                            @i
                                        </button>
                                    }
                                }
                                
                                <button class="page-btn" onclick="changePage(@(Model.CurrentPage + 1))" @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")>
                                    <i class="fas fa-angle-right"></i>
                                </button>
                                <button class="page-btn" onclick="changePage(@Model.TotalPages)" @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")>
                                    <i class="fas fa-angle-double-right"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function applyFilters() {
            var month = document.getElementById('monthPicker').value;
            var staff = document.getElementById('staffSelect').value;
            
            // Build URL with parameters
            var url = '/attendance?';
            if (month) url += 'selectedMonth=' + encodeURIComponent(month) + '&';
            if (staff) url += 'selectedStaff=' + encodeURIComponent(staff) + '&';
            url += 'page=1'; // reset to first page
            
            window.location.href = url;
        }

        function refreshPage() {
            window.location.href = '/attendance';
        }

        function changePage(page) {
            var url = new URL(window.location.href);
            url.searchParams.set('page', page);
            // Add a random parameter to force refresh
            url.searchParams.set('t', Date.now());
            window.location.href = url.toString();
        }

        document.querySelector('.menu-toggle').addEventListener('click', function() {
            document.querySelector('.sidebar').classList.toggle('active');
        });
    </script>
</body>
</html>